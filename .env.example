# ── Security (backend) ─────────────────────────────────────────────────────
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Logging (backend) ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
ENABLE_JSON_LOGS=false

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@db:5432/price_monitor

# ── Redis / Celery (scrapers) ─────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0

# ── Scraper → Backend communication ──────────────────────────────────────
API_URL=http://web:8000
CELERY_WORKER_USERNAME=celery_user
CELERY_WORKER_PASSWORD=celery_user_password

# ── Frontend ──────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Residential Proxy (scrapers — Mercado Livre) ─────────────────────────
# Required only for Mercado Livre scraping.  Other scrapers work without it.
# Get credentials from a residential proxy provider (Bright Data, SmartProxy,
# Oxylabs, IPRoyal, etc.) — must have Brazilian residential IPs.
PROXY_ENABLED=false
PROXY_SERVER=http://gate.smartproxy.com:7000
PROXY_USERNAME=your_proxy_user
PROXY_PASSWORD=your_proxy_password
