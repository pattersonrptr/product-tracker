# =============================================================================
# Product Tracker — Unified .gitignore
# =============================================================================

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Poetry / pip
pip-log.txt

# Testing / coverage
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Celery
celerybeat-schedule
celerybeat.pid

# Alembic auto-generated migrations
backend/alembic/versions/

# ── Node.js / Frontend ──────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Environment variables ───────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Editors & OS ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── CI / local runners ──────────────────────────────────────────────────────
.actrc
.secrets.act

# ── Misc ─────────────────────────────────────────────────────────────────────
*.db
*.ipynb
notes.txt
scrapers/scraper_test_report.json
